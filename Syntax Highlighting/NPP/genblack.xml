<NotepadPlus>
    <UserLang name="GenBlack" ext="" udlVersion="2.1">
        <Settings>
            <Global caseIgnored="yes" allowFoldOfComments="no" foldCompact="no" forcePureLC="0" decimalSeparator="0" />
            <Prefix Keywords1="no" Keywords2="no" Keywords3="no" Keywords4="no" Keywords5="no" Keywords6="no" Keywords7="no" Keywords8="no" />
        </Settings>
        <KeywordLists>
            <Keywords name="Comments">00# 01 02((EOL)) 03 04</Keywords>
            <Keywords name="Numbers, prefix1"></Keywords>
            <Keywords name="Numbers, prefix2"></Keywords>
            <Keywords name="Numbers, extras1"></Keywords>
            <Keywords name="Numbers, extras2"></Keywords>
            <Keywords name="Numbers, suffix1"></Keywords>
            <Keywords name="Numbers, suffix2"></Keywords>
            <Keywords name="Numbers, range"></Keywords>
            <Keywords name="Operators1"></Keywords>
            <Keywords name="Operators2"></Keywords>
            <Keywords name="Folders in code1, open"></Keywords>
            <Keywords name="Folders in code1, middle"></Keywords>
            <Keywords name="Folders in code1, close"></Keywords>
            <Keywords name="Folders in code2, open"></Keywords>
            <Keywords name="Folders in code2, middle"></Keywords>
            <Keywords name="Folders in code2, close"></Keywords>
            <Keywords name="Folders in comment, open"></Keywords>
            <Keywords name="Folders in comment, middle"></Keywords>
            <Keywords name="Folders in comment, close"></Keywords>
            <Keywords name="Keywords1">ENABLE DIASABLE GLUE DELETE_ALL CLEAN_ALL DELETE_MODEL DELETE_BLANK CLEAN_MODEL DELETE_COL CLEAN_COL DELETE_SHADOW CLEAN_SHADOW DELETE CLEAN ADD ADD_LOD1 ADD_SHADOW ADD_LOD2 ADD_COL ADJUST_TEXTURE_SIZE RENDER_TEMPLATE SET_TEXTURE_SLOT SET_TEXTURE_SLOT2 SET_TEXTURE_SLOT3 NEW_OBJECT SET_COLOR DEL SET_BB CHECK_BB SCALE_TEXTURE MOVE_TEXTURE PLATE_FIX</Keywords>
            <Keywords name="Keywords2">SINGLE EXTEND</Keywords>
            <Keywords name="Keywords3">OPAQUE SHINE</Keywords>
            <Keywords name="Keywords4">TOP FRONT SIDE BACK</Keywords>
            <Keywords name="Keywords5">MODEL</Keywords>
            <Keywords name="Keywords6">MESH</Keywords>
            <Keywords name="Keywords7">SUBMESHES_COUNT &quot;MIRROR_STATE MIRROR_ONLY&quot; &quot;MIRROR_STATE MIRROR_FIX_POSSIBLE&quot; &quot;MESH_TYPE MAIN&quot; &quot;MESH_TYPE CALIPER&quot; &quot;MESH_TYPE WHEEL&quot; &quot;MESH_TYPE DEFAULT&quot; &quot;MESH_TYPE ALWAYS_VISIBLE&quot; &quot;MESH_TYPE MIRROR&quot; &quot;MESH_FIX ON&quot; &quot;MESH_FIX OFF&quot; &quot;MIRROR on&quot; &quot;MIRROR OFF&quot; &quot;MIRROR FIX&quot; &quot;MIRROR FIX2&quot; &quot;MIRROR FIX3&quot; &quot;MIRROR BODYON&quot; &quot;MIRROR BODYOFF&quot; &quot;MIRROR BODYFIX&quot;</Keywords>
            <Keywords name="Keywords8">LOAD WRITE EXIT</Keywords>
            <Keywords name="Delimiters"></Keywords>
        </KeywordLists>
        <Styles>
            <WordsStyle name="DEFAULT" fgColor="F1F2F3" bgColor="1E1E1E" fontName="" fontStyle="0" nesting="0" />
            <WordsStyle name="COMMENTS" fgColor="008000" bgColor="1E1E1E" fontName="" fontStyle="0" nesting="0" />
            <WordsStyle name="LINE COMMENTS" fgColor="57A64A" bgColor="1E1E1E" fontName="" fontStyle="0" nesting="0" />
            <WordsStyle name="NUMBERS" fgColor="C1D6B6" bgColor="1E1E1E" fontName="" fontStyle="0" nesting="0" />
            <WordsStyle name="KEYWORDS1" fgColor="3CAAF0" bgColor="1E1E1E" fontName="" fontStyle="0" nesting="0" />
