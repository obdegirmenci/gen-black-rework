        <!-- ========== 2. CONTEXTS (RULES) ========== -->
        <contexts>
            <context name="Normal" attribute="Normal" lineEndContext="#stay">
                <!-- Yorum Satırı: # ile başlayan ve satır sonuna kadar devam eden -->
                <RegExpr attribute="Comment" context="#stay" String="#.*$" />

                <!-- Sekiz anahtar kelime listesini kontrol et -->
                <keyword attribute="Keyword1" context="#stay" String="keywords1" />
                <keyword attribute="Keyword2" context="#stay" String="keywords2" />
                <keyword attribute="Keyword3" context="#stay" String="keywords3" />
                <keyword attribute="Keyword4" context="#stay" String="keywords4" />
                <keyword attribute="Keyword5" context="#stay" String="keywords5" />
                <keyword attribute="Keyword6" context="#stay" String="keywords6" />
                <keyword attribute="Keyword7" context="#stay" String="keywords7" />
                <keyword attribute="Keyword8" context="#stay" String="keywords8" />

                <!-- Sayılar -->
                <RegExpr attribute="Number" context="#stay" String="\b[0-9]+\b" />
            </context>
        </contexts>

        <!-- ========== 3. ATTRIBUTES (STYLES & COLORS) ========== -->
        <itemDatas>
            <itemData name="Normal" defStyleNum="dsNormal" color="#F1F2F3" bgColor="#1E1E1E" />
            <itemData name="Comment" defStyleNum="dsComment" color="#57A64A" bgColor="#1E1E1E" italic="1" />
            <itemData name="Number" defStyleNum="dsDecNumber" color="#C1D6B6" bgColor="#1E1E1E" />
            <itemData name="Keyword1" defStyleNum="dsKeyword" color="#3CAAF0" bgColor="#1E1E1E" bold="1" />
            <itemData name="Keyword2" defStyleNum="dsDataType" color="#E281E0" bgColor="#1E1E1E" />
            <itemData name="Keyword3" defStyleNum="dsFunction" color="#4DC7AE" bgColor="#1E1E1E" />
            <itemData name="Keyword4" defStyleNum="dsControlFlow" color="#FF8F59" bgColor="#1E1E1E" />
            <itemData name="Keyword5" defStyleNum="dsOthers" color="#FF8080" bgColor="#1E1E1E" />
            <itemData name="Keyword6" defStyleNum="dsOthers" color="#CB4141" bgColor="#1E1E1E" />
            <itemData name="Keyword7" defStyleNum="dsOthers" color="#F04E00" bgColor="#1E1E1E" />
            <itemData name="Keyword8" defStyleNum="dsOthers" color="#FFFF7D" bgColor="#1E1E1E" />
        </itemDatas>
